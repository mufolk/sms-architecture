            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('answers well under Twilio\\'s 5s ceiling', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "if (pm.response.code === 503) {",
                  "  pm.test('queue unavailable', () => pm.expect(pm.response.json().error).to.eql('queue unavailable'));",
                  "} else {",
                  "  pm.test('200 — Redis is up, nothing degraded here', () => pm.response.to.have.status(200));",
                  "  console.log('Redis is up: stop it to exercise the degraded path.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/webhooks/sms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "sms"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "MessageSid",
                  "value": "{{messageSid}}",
                  "type": "text"
                },
                {
                  "key": "From",
                  "value": "{{userNumber}}",
                  "type": "text"
                },
                {
                  "key": "To",
                  "value": "{{inboundNumber}}",
                  "type": "text"
                },
                {
                  "key": "Body",
                  "value": "redis down",
                  "type": "text"
                }
              ]
            },
            "description": "With Redis down the enqueue must give up in ~2s and answer 503, never hang past Twilio's timeout. The Message is already persisted at that point: the redelivery is deduplicated and it stays in 'received' until the reaper lands (ticket 05)."
          }
        },
