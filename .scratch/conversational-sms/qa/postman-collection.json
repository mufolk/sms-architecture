    {
      "name": "6. End to end (run the folder in the Runner)",
      "description": "Posts a new Message, finds the Conversation and polls until the reply is out. Needs the worker running. With PROCESSING_DELAY_MS=3000 the reply takes ~3s.",
      "item": [
        {
          "name": "E2E 1 — post the message",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const stamp = pm.variables.replaceIn('{{$timestamp}}');",
                  "pm.collectionVariables.set('messageSid', 'SME2E' + stamp);",
                  "// a fresh number per run isolates this test's conversation",
                  "pm.collectionVariables.set('e2eNumber', '+5511' + String(stamp).slice(-9));",
                  "pm.collectionVariables.set('pollAttempt', 0);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('under Twilio\\'s 5s ceiling', () => pm.expect(pm.response.responseTime).to.be.below(5000));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/webhooks/sms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "sms"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "MessageSid",
                  "value": "{{messageSid}}",
                  "type": "text"
                },
                {
                  "key": "From",
                  "value": "{{e2eNumber}}",
                  "type": "text"
                },
                {
                  "key": "To",
                  "value": "{{inboundNumber}}",
                  "type": "text"
                },
                {
                  "key": "Body",
                  "value": "ping e2e",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "E2E 2 — find the conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cs = pm.response.json().conversations;",
                  "const mine = cs.filter(c => c.userNumber === pm.collectionVariables.get('e2eNumber'));",
                  "pm.test('the conversation was created', () => pm.expect(mine.length).to.eql(1));",
                  "if (mine.length) pm.collectionVariables.set('e2eConversationId', mine[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversations"
              ]
            }
          }
        },
        {
          "name": "E2E 3 — poll until the reply is out",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ms = pm.response.json().messages;",
                  "const inbound = ms.find(m => m.direction === 'inbound');",
                  "const outbound = ms.find(m => m.direction === 'outbound');",
                  "let n = Number(pm.collectionVariables.get('pollAttempt') || 0) + 1;",
                  "pm.collectionVariables.set('pollAttempt', n);",
                  "",
                  "if (!outbound && n < 20) {",
                  "  console.log('attempt ' + n + ': no reply yet (inbound=' + (inbound && inbound.status) + ')');",
                  "  pm.execution.setNextRequest('E2E 3 — poll until the reply is out');",
                  "} else {",
                  "  pm.test('the reply went out', () => pm.expect(outbound, 'no outbound after ' + n + ' attempts — is the worker up?').to.exist);",
                  "  if (outbound) {",
                  "    pm.test('the reply echoes the inbound text', () => pm.expect(outbound.body).to.eql('Reply: ' + inbound.body));",
                  "    pm.test('the reply points at the inbound message', () => pm.expect(outbound.inReplyTo).to.eql(inbound.id));",
                  "    pm.test('the reply is marked sent', () => pm.expect(outbound.status).to.eql('sent'));",
                  "    pm.test('the inbound is marked processed', () => pm.expect(inbound.status).to.eql('processed'));",
                  "    pm.test('the fake provider sid is filled in', () => pm.expect(outbound.providerMessageSid).to.match(/^FAKE/));",
                  "  }",
                  "  pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/{{e2eConversationId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversations",
                "{{e2eConversationId}}",
                "messages"
              ]
            },
            "description": "Repeats itself until the outbound Message shows up (20 attempts max). In the Runner, set a 1000ms delay between requests."
          }
        }
      ]
    },
    {
      "name": "7. Degraded — Redis down",
      "description": "Stop Redis with `docker compose stop redis`, run this folder, then bring it back with `docker compose start redis`. The requests also pass with Redis up, so the folder is safe inside a full run.",
      "item": [
        {
