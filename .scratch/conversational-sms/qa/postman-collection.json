    {
      "name": "5. Admin REST",
      "item": [
        {
          "name": "GET /conversations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const cs = pm.response.json().conversations;",
                  "pm.test('conversations is an array', () => pm.expect(cs).to.be.an('array'));",
                  "const mine = cs.filter(c => c.userNumber === pm.collectionVariables.get('userNumber'));",
                  "if (mine.length) {",
                  "  pm.collectionVariables.set('conversationId', mine[mine.length - 1].id);",
                  "  console.log('conversationId =', mine[mine.length - 1].id);",
                  "} else if (cs.length) {",
                  "  pm.collectionVariables.set('conversationId', cs[cs.length - 1].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversations"
              ]
            },
            "description": "Today the list comes back ascending by lastMessageAt (most recent last). Ticket 03 asks for the opposite."
          }
        },
        {
          "name": "GET /conversations/:id/messages",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const ms = pm.response.json().messages;",
                  "pm.test('has an inbound message', () => pm.expect(ms.some(m => m.direction === 'inbound')).to.be.true);",
                  "const pending = ms.filter(m => m.direction === 'inbound' && m.status !== 'processed');",
                  "console.log(ms.length + ' message(s), ' + pending.length + ' inbound still pending');",
                  "ms.forEach(m => console.log(m.direction, m.status, JSON.stringify(m.body).slice(0, 60)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/{{conversationId}}/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversations",
                "{{conversationId}}",
                "messages"
              ]
            },
            "description": "Run 'GET /conversations' first — it fills conversationId."
          }
        },
        {
          "name": "Unknown conversation → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));",
                  "pm.test('conversation not found', () => pm.expect(pm.response.json().error).to.eql('conversation not found'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/11111111-1111-4111-8111-111111111111/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversations",
                "11111111-1111-4111-8111-111111111111",
                "messages"
              ]
            }
          }
        },
        {
          "name": "Malformed id → 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404', () => pm.response.to.have.status(404));",
                  "pm.test('conversation not found', () => pm.expect(pm.response.json().error).to.eql('conversation not found'));",
                  "pm.test('no internal Postgres error leaks', () => pm.expect(pm.response.text()).to.not.include('22P02'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/conversations/abc/messages",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "conversations",
                "abc",
                "messages"
              ]
            },
            "description": "An id that is not a UUID is rejected at the edge, before Postgres is touched. It used to answer 500 with the raw Postgres error (22P02)."
          }
        },
        {
