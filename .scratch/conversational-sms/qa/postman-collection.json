      "name": "2. Webhook — happy path",
      "item": [
        {
          "name": "POST /webhooks/sms (new message)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// a fresh MessageSid per run, kept for the redelivery folder",
                  "const sid = 'SM' + pm.variables.replaceIn('{{$timestamp}}') + Math.floor(Math.random() * 1e6);",
                  "pm.collectionVariables.set('messageSid', sid);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('well under Twilio\\'s 5s ceiling', () => pm.expect(pm.response.responseTime).to.be.below(5000));",
                  "pm.test('empty body', () => pm.expect(pm.response.text()).to.eql(''));",
                  "pm.collectionVariables.set('lastMessageSid', pm.collectionVariables.get('messageSid'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/webhooks/sms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "sms"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "MessageSid",
                  "value": "{{messageSid}}",
                  "type": "text"
                },
                {
                  "key": "From",
                  "value": "{{userNumber}}",
                  "type": "text"
                },
                {
                  "key": "To",
                  "value": "{{inboundNumber}}",
                  "type": "text"
                },
                {
                  "key": "Body",
                  "value": "Hello, testing",
                  "type": "text"
                },
                {
                  "key": "AccountSid",
                  "value": "AC00000000000000000000000000000000",
                  "type": "text"
                },
                {
                  "key": "NumSegments",
                  "value": "1",
                  "type": "text"
                }
              ]
            },
            "description": "Twilio posts application/x-www-form-urlencoded. The API answers 200 with an empty body and enqueues the processing. Twilio's ceiling is 5s."
          }
        },
