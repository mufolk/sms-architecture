                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "sms"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "MessageSid",
                  "value": "{{lastMessageSid}}",
                  "type": "text"
                },
                {
                  "key": "From",
                  "value": "{{userNumber}}",
                  "type": "text"
                },
                {
                  "key": "To",
                  "value": "{{inboundNumber}}",
                  "type": "text"
                },
                {
                  "key": "Body",
