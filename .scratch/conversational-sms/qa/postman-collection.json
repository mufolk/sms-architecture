      "name": "4. Redelivery (ADR-0004)",
      "item": [
        {
          "name": "Replay the last MessageSid → 200, no duplicate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('lastMessageSid is set (run the happy path first)', () => {",
                  "  pm.expect(pm.collectionVariables.get('lastMessageSid')).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/webhooks/sms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "webhooks",
                "sms"
              ]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "MessageSid",
                  "value": "{{lastMessageSid}}",
                  "type": "text"
                },
                {
                  "key": "From",
                  "value": "{{userNumber}}",
                  "type": "text"
                },
                {
                  "key": "To",
                  "value": "{{inboundNumber}}",
                  "type": "text"
                },
                {
                  "key": "Body",
                  "value": "Hello, testing",
                  "type": "text"
                }
              ]
            },
            "description": "Run 'POST /webhooks/sms (new message)' first. The redelivery is absorbed: no new Message, no second reply. A late reply beats a duplicate reply."
          }
        },
