{
  "name": "conversational-sms",
  "private": true,
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p tests/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "pnpm --filter @conversational-sms/core db:generate",
    "db:migrate": "pnpm --filter @conversational-sms/core db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testcontainers/postgresql": "^10.28.0",
    "@testcontainers/redis": "^10.28.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^9",
    "globals": "^17.11.0",
    "pg": "^8.14.1",
    "testcontainers": "^10.28.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8",
    "vitest": "^3.0.9"
  },
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  }
}
